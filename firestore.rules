
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to pandals, as this is public data for the map.
    // Disallow write access from the client.
    match /pandals/{pandalId} {
      allow read: if true;
      allow write: if false;
    }

    // Allow public read access to Metro stations.
    match /Metro/{metroId} {
      allow read: if true;
      allow write: if false;
    }

    // Per-user data — only the owning authenticated user can read/write.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
